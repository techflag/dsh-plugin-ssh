{
  "name": "dsh-plugin-ssh",
  "version": "0.1.0",
  "description": "DeepSeek Harness 的 SSH / SFTP 工作区：多主机终端、文件传输与编辑、复用宿主模型的 AI 命令助手。",
  "author": "TechFlag",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib', {recursive:true,force:true})\" && tsdown && vite build && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "pack:plugin": "npm run build && mkdir -p dist && npm pack --pack-destination dist && mv dist/dsh-plugin-ssh-0.1.0.tgz dist/dsh-plugin-ssh.tgz",
    "check": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-rc.1 || ^0.1.3-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1 || ^0.1.3-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1 || ^0.1.3-alpha.2",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1 || ^0.1.3-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1 || ^0.1.3-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-attachment": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-store": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-invariants": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-session": "^0.1.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.3-alpha.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.8"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ssh",
    "sftp",
    "terminal",
    "ai-assistant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techflag/dsh-plugin-ssh.git"
  },
  "homepage": "https://github.com/techflag/dsh-plugin-ssh#readme",
  "bugs": {
    "url": "https://github.com/techflag/dsh-plugin-ssh/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.28.0"
}
